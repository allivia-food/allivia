# Copie este arquivo para .env e preencha com os dados do projeto no Supabase
# (Project Settings -> API). Use somente a chave pública (anon/publishable).
# Nunca coloque a chave service_role aqui. O arquivo .env não vai para o Git.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Identificador da build; use o identificador existente se o app já foi publicado.
ANDROID_APP_ID=com.allivia.app
